{
  "name": "agency-agents-app",
  "version": "0.3.0",
  "description": "Agency Agents — a native app for browsing, installing, and tracking specialized AI agents across coding tools.",
  "type": "module",
  "author": "Michael Sitarzewski",
  "repository": "github:msitarzewski/agency-agents-app",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:phase-c": "tools/phase-c/phase-c.sh",
    "build:phase-c:full": "PHASE_C_INCLUDE_VMS=1 tools/phase-c/phase-c.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:frontend": "svelte-kit sync && vitest run",
    "verify:frontend": "npm run check && npm run test:frontend && npm run build",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "jsdom": "^26.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "cookie": "^0.7.0"
  }
}
